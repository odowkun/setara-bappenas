APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SANCTUM_EXPIRATION=480

# Wajib diisi hanya saat bootstrap Super Admin melalui `php artisan db:seed`.
# Jangan commit nilai password aktual ke repository.
BAPPEDA_SEED_SUPERADMIN_NAME="Super Admin BAPPEDA Halut"
BAPPEDA_SEED_SUPERADMIN_EMAIL=
BAPPEDA_SEED_SUPERADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi HTTPS: set SESSION_ENCRYPT=true dan SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

DOCUMENT_WATERMARK_TEXT="BAPPEDA HALUT"
DOCUMENT_WATERMARK_OPACITY=0.06
DOCUMENT_WATERMARK_ANGLE=35
DOCUMENT_WATERMARK_COLUMNS=3
DOCUMENT_WATERMARK_ROWS=4
DOCUMENT_CONVERSION_TIMEOUT=120
LIBREOFFICE_BINARY=

# Arsip pengetahuan dokumen: seluruh berkas wajib berada pada disk privat.
DOCUMENT_ARCHIVE_DISK=local
DOCUMENT_ARCHIVE_CODE_PREFIX=BPH-DOC
DOCUMENT_PREVIEW_TTL_MINUTES=5
DOCUMENT_DOWNLOAD_TTL_MINUTES=5
DOCUMENT_EXTRACTION_TIMEOUT=120
DOCUMENT_OCR_PAGE_TIMEOUT=60
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_LANGUAGE=ind+eng
DOCUMENT_OCR_RESOLUTION=200
DOCUMENT_OCR_MAX_PAGES=100
DOCUMENT_RETENTION_SCAN_LIMIT=500
# Kosongkan agar binary ditemukan otomatis dari PATH.
PDFTOTEXT_BINARY=
PDFINFO_BINARY=
PDFTOPPM_BINARY=
TESSERACT_BINARY=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile CAPTCHA / Bot Protection
# Dapatkan di: https://dash.cloudflare.com/?to=/:account/turnstile
# Dummy Testing Keys:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
